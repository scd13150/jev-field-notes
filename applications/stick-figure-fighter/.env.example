# TYPESAFE_API_KEY is read from the environment by the server and the live spar
# runner. Copy to .env (gitignored) or export it in your shell.
# Get a key at https://dash.typesafe.ai and never commit the real value.
TYPESAFE_API_KEY=
# Optional: pin a model instead of the "jev-latest" alias (e.g. jev-1.13.0).
# The two spar fighters can even use different tags via --model1 / --model2.
TYPESAFE_MODEL=jev-latest
# Optional server port for the browser game (default 8787).
PORT=8787
